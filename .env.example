# ==========================================================================
# AI Tutor — environment configuration
# Copy to ".env" and fill in real values when moving from mock -> real.
# Everything works out-of-the-box in MOCK mode with no values set.
# ==========================================================================

APP_ENV=development
DEFAULT_LANGUAGE=en

# --------------------------------------------------------------------------
# Provider selection.  Each can be "mock" or "dell" independently, so you can
# mix (e.g. real LLM but mock translation) while prototyping.
#   mock -> deterministic in-process stub, no network, no GPU, no keys
#   dell -> calls a Dell AI Factory endpoint (NVIDIA NIM / OpenAI-compatible)
# --------------------------------------------------------------------------
LLM_PROVIDER=mock
VLM_PROVIDER=mock
TRANSLATE_PROVIDER=mock

# --------------------------------------------------------------------------
# Dell AI Factory — reasoning LLM (OpenAI-compatible chat completions API,
# e.g. an NVIDIA NIM container serving Llama / Qwen on Dell hardware)
# --------------------------------------------------------------------------
DELL_LLM_BASE_URL=http://localhost:8001/v1
DELL_LLM_API_KEY=changeme
DELL_LLM_MODEL=meta/llama-3.1-8b-instruct

# --------------------------------------------------------------------------
# Dell AI Factory — vision/multimodal model for reading handwritten working
# from screenshots (a VLM such as Qwen2-VL / Llama-3.2-Vision served via NIM)
# --------------------------------------------------------------------------
DELL_VLM_BASE_URL=http://localhost:8002/v1
DELL_VLM_API_KEY=changeme
DELL_VLM_MODEL=qwen/qwen2-vl-7b-instruct

# --------------------------------------------------------------------------
# WhatsApp channel.  "mock" simulates send/receive locally; "cloud" uses the
# Meta WhatsApp Business Cloud API.
# --------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Token you choose; must match what you enter in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=ai-tutor-verify
